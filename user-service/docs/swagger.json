            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "OAuth login/signup via provider",
                "parameters": [
                    {
                        "type": "string",
                        "description": "google or github",
                        "name": "provider",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "OAuth token",
                        "name": "params",
