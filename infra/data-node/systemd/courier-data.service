[Unit]
Description=Courier private data services
Requires=docker.service
After=docker.service data.mount network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/courier/data-node
ExecStartPre=/usr/local/lib/courier/hydrate-data-env.sh
ExecStartPre=/usr/local/bin/docker-compose --env-file /etc/courier/data.env -f /opt/courier/data-node/compose.yaml config --quiet
ExecStart=/usr/local/bin/docker-compose --env-file /etc/courier/data.env -f /opt/courier/data-node/compose.yaml up --detach --remove-orphans
ExecStop=/usr/local/bin/docker-compose --env-file /etc/courier/data.env -f /opt/courier/data-node/compose.yaml down
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
