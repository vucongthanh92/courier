{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courier.local/events/user.email_verified.v1.json",
  "title": "user.email_verified.v1",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "source",
    "aggregate_type",
    "aggregate_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "const": "user.email_verified"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "user-service"
    },
    "aggregate_type": {
      "const": "user"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "user_id",
        "email",
        "status"
      ],
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "status": {
          "const": "verified"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
