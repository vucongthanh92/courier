{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courier.local/events/conversation.created.v1.json",
  "title": "conversation.created.v1",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "source",
    "aggregate_type",
    "aggregate_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "const": "conversation.created"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_type": {
      "const": "conversation"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "conversation_id",
        "conversation_type",
        "created_by",
        "member_user_ids"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "conversation_type": {
          "enum": ["direct", "group"]
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "member_user_ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
