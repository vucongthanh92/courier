SERVICE_NAME=agent-gateway
HTTP_PORT=:5010
SHUTDOWN_TIMEOUT=10s

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=courier_agent_memory
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=5s

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=agent-gateway
KAFKA_ASSISTANT_REQUESTED_TOPIC=courier.assistant.requested.v1
KAFKA_ASSISTANT_RESPONDED_TOPIC=courier.assistant.responded.v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REQUEST_TIMEOUT=45s
OPENAI_MAX_RECENT_TURNS=20
OPENAI_MAX_MEMORY_CHUNKS=8
MEMORY_SUMMARY_EVERY_MESSAGES=20
